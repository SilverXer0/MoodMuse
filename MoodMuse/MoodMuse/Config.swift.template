// Config.swift
// MoodMuse
//
// 🔑 SETUP REQUIRED:
// 1. Replace YOUR_SPOTIFY_CLIENT_ID with your Spotify app's Client ID
//    (get it from https://developer.spotify.com/dashboard)
// 2. In your Spotify app settings, add "moodmuse://callback" as a Redirect URI
// 3. In Xcode, add a URL Scheme "moodmuse" under Target → Info → URL Types

import Foundation

enum SpotifyConfig {
    // MARK: - 🔑 Replace this with your real Client ID
    static let clientID = "YOUR_SPOTIFY_CLIENT_ID"

    static let redirectURI = "moodmuse://callback"

    static let scopes = [
        "user-library-read",
        "user-library-modify",
        "user-read-playback-state",
        "user-modify-playback-state",
        "playlist-read-private",
        "streaming"
    ].joined(separator: " ")

    // MARK: - Endpoints
    static let authorizationURL = URL(string: "https://accounts.spotify.com/authorize")!
    static let tokenURL         = URL(string: "https://accounts.spotify.com/api/token")!
    static let apiBaseURL       = URL(string: "https://api.spotify.com/v1")!
}
